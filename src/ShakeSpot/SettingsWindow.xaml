<Window x:Class="ShakeSpot.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ShakeSpot 设置" Width="490" SizeToContent="Height" MinWidth="450"
    ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#F6F7F9"
    FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="晃一晃，找到鼠标" FontSize="25" FontWeight="SemiBold" Foreground="#152032"/>
      <TextBlock Text="快速左右或上下往返晃动，箭头就会放大。" Margin="0,8,0,0" Foreground="#586174"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E1E5EB" BorderThickness="1" Padding="20">
      <StackPanel>
        <Grid><TextBlock Text="灵敏度"/><TextBlock x:Name="SensitivityValue" HorizontalAlignment="Right" Foreground="#586174"/></Grid>
        <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,2" ValueChanged="ValueChanged" AutomationProperties.Name="灵敏度"/>
        <Grid Margin="0,0,0,20"><TextBlock Text="更不易误触" FontSize="12" Foreground="#737C8D"/><TextBlock Text="更容易触发" HorizontalAlignment="Right" FontSize="12" Foreground="#737C8D"/></Grid>
        <Grid><TextBlock Text="最大放大倍数"/><TextBlock x:Name="ScaleValue" HorizontalAlignment="Right" Foreground="#586174"/></Grid>
        <Slider x:Name="ScaleSlider" Minimum="2" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,12,0,20" ValueChanged="ValueChanged" AutomationProperties.Name="最大放大倍数"/>
        <Grid><TextBlock Text="效果持续时间"/><TextBlock x:Name="DurationValue" HorizontalAlignment="Right" Foreground="#586174"/></Grid>
        <Slider x:Name="DurationSlider" Minimum="500" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" Margin="0,12,0,6" ValueChanged="ValueChanged" AutomationProperties.Name="效果持续时间"/>
        <TextBlock Text="再次晃动会延长效果；点击或拖动时自动收起。" FontSize="12" Foreground="#737C8D" TextWrapping="Wrap"/>
        <Separator Margin="0,20,0,16" Background="#E1E5EB"/>
        <CheckBox x:Name="StartupCheckBox" Content="登录 Windows 时启动"/>
        <TextBlock Text="默认关闭。启用前请将程序放在固定位置。" FontSize="12" Margin="22,7,0,0" Foreground="#737C8D" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,16,0,20" Foreground="#586174" FontSize="12" TextWrapping="Wrap" Text="右键托盘图标可随时暂停。连续晃动不会叠加箭头。"/>
    <DockPanel Grid.Row="3" LastChildFill="False">
      <Button Content="恢复默认" Click="DefaultsClick" Margin="0" DockPanel.Dock="Left"/>
      <Button Content="保存" Click="SaveClick" IsDefault="True" DockPanel.Dock="Right" Background="#1763C6" Foreground="White" BorderBrush="#1763C6"/>
      <Button Content="取消" Click="CancelClick" IsCancel="True" DockPanel.Dock="Right"/>
    </DockPanel>
  </Grid>
</Window>
