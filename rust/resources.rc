#pragma code_page(65001)
#define DS_SETFONT 0x40
#define DS_MODALFRAME 0x80
#define WS_POPUP 0x80000000
#define WS_CAPTION 0x00C00000
#define WS_SYSMENU 0x00080000
#define WS_VSCROLL 0x00200000
#define WS_TABSTOP 0x00010000
#define CBS_DROPDOWNLIST 3
#define IDOK 1
#define IDCANCEL 2
#define VOS_NT_WINDOWS32 0x00040004
#define VFT_APP 1
#define IDD_SETTINGS 101
#define IDC_SENSITIVITY 1001
#define IDC_SCALE 1002
#define IDC_DURATION 1003
#define IDC_STARTUP 1004
#define IDC_DEFAULTS 1005
#define IDC_STATUS 1006
#define IDC_EXCLUDED_APPS 1007


IDD_SETTINGS DIALOGEX 0, 0, 290, 347
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ShakeSpot 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
  LTEXT "晃一晃，直接放大系统鼠标指针", -1, 16, 14, 255, 14
  LTEXT "灵敏度", -1, 16, 43, 125, 12
  COMBOBOX IDC_SENSITIVITY, 166, 40, 105, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "最大放大倍数", -1, 16, 73, 125, 12
  COMBOBOX IDC_SCALE, 166, 70, 105, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "效果持续时间", -1, 16, 103, 125, 12
  COMBOBOX IDC_DURATION, 166, 100, 105, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  AUTOCHECKBOX "登录 Windows 时启动", IDC_STARTUP, 16, 131, 240, 14, WS_TABSTOP
  LTEXT "排除应用（每行一个程序名或完整路径）", -1, 16, 155, 256, 12
  EDITTEXT IDC_EXCLUDED_APPS, 16, 172, 255, 70, 0x0004 | 0x0040 | 0x1000 | WS_VSCROLL | WS_TABSTOP
  LTEXT "例如 notepad.exe；这些应用位于前台时暂停效果。", -1, 16, 247, 256, 12
  LTEXT "按住鼠标键时暂停放大；松开后可再次晃动。\n指针最大 256 像素，高缩放时可能达不到所选倍率。", -1, 16, 267, 256, 25
  LTEXT "", IDC_STATUS, 16, 295, 256, 23
  PUSHBUTTON "恢复默认", IDC_DEFAULTS, 16, 320, 65, 18
  PUSHBUTTON "取消", IDCANCEL, 139, 320, 61, 18
  DEFPUSHBUTTON "保存", IDOK, 209, 320, 62, 18
END

1 VERSIONINFO
FILEVERSION 0,4,3,0
PRODUCTVERSION 0,4,3,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ShakeSpot Rust system cursor locator\0"
      VALUE "ProductName", "ShakeSpot\0"
      VALUE "ProductVersion", "0.4.3\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 24 "app.manifest"


